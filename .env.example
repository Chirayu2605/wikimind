# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM ───────────────────────────────────────────────────
# Option A: Standard OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Option B: Groq (free tier — https://console.groq.com)
OPENAI_API_KEY=gsk_...
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama3-70b-8192

# ── Redis ─────────────────────────────────────────────────
# Docker Compose (app talks to the redis service container):
REDIS_URL=redis://redis:6379
# Plain uvicorn (no Docker):
# REDIS_URL=redis://localhost:6379

# Cache TTL in seconds (default: 604800 = 7 days)
REDIS_TTL_SECONDS=604800

# ── Retrieval ─────────────────────────────────────────────
# Number of top chunks passed to the LLM (default: 4)
TOP_K_CHUNKS=4
